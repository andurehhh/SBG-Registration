{
  "name": "sbg-portal-backend",
  "version": "1.0.0",
  "description": "SBG Portal Express API",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "googleapis": "^137.1.0",
    "jsonwebtoken": "^9.0.2",
    "mailersend": "^2.2.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.22.4"
  },
  "prisma": {
    "schema": "../prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^2.1.9",
    "fast-check": "^3.23.2",
    "prisma": "^5.11.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
