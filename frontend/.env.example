VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
VITE_APP_URL=http://localhost:5173

# URL of the main marketing website (the "Back to site" links point here).
# Leave blank to fall back to the app root.
VITE_MARKETING_URL=https://awssbg-pupbinan.cloud

# Admin panel access (set to 'true' to include admin routes in the build)
VITE_ADMIN_ENABLED=true
# Secret URL path for admin panel (change this to something only your team knows)
VITE_ADMIN_PATH=portal-ctrl
